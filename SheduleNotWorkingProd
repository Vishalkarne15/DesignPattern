package com.sbi.rlms.scheduler.config.trigger;

import org.quartz.CronTrigger;
import org.quartz.JobDetail;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.quartz.CronTriggerFactoryBean;
import org.springframework.scheduling.quartz.JobDetailFactoryBean;

import com.sbi.rlms.scheduler.jobs.ReversFeedPMVLPQuartzJob;
import com.sbi.rlms.scheduler.jobs.ReversFeedRetriggerQuartzJob;

import lombok.Getter;
import lombok.Setter;
import lombok.extern.slf4j.Slf4j;

@Configuration
@Getter
@Setter
@Slf4j
public class ReverseFeedPMVLPTriggerConfig {
	@Value("${revers.feed.pmvlp.trigger.time}")
	private String reverseFeedPMVLPTriggerTime;
	@Bean
	public JobDetailFactoryBean reverseFeedPMVLPQuartzJobDetail() {
		JobDetailFactoryBean jobDetailFactory = new JobDetailFactoryBean();
		jobDetailFactory.setJobClass(ReversFeedPMVLPQuartzJob.class);
		jobDetailFactory.setDescription("reversFeedPMVLPQuartzJob");
		jobDetailFactory.setDurability(true);
		return jobDetailFactory;
	}
	@Bean
	public CronTriggerFactoryBean reverseFeedPMVLPQuartzJobTrigger(@Autowired @Qualifier("reverseFeedPMVLPQuartzJobDetail") JobDetail job) {
		CronTriggerFactoryBean cronTriggerFactoryBean = new CronTriggerFactoryBean();
		cronTriggerFactoryBean.setJobDetail(job);
		cronTriggerFactoryBean.setCronExpression(reverseFeedPMVLPTriggerTime);
		cronTriggerFactoryBean.setName("reversFeedPMVLPQuartzJob");
		cronTriggerFactoryBean.setMisfireInstruction(CronTrigger.MISFIRE_INSTRUCTION_FIRE_ONCE_NOW);
		return cronTriggerFactoryBean;
	}
}

