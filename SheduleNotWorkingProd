	@Override
	public Map<Long,ELVLPUpdateLoanMainRequestDTO> loadPMVLPJSONRequest() {
		
		List<ApplELReverseFeedReqRespTrn> failListData = applELReverseFeedReqRespRepository.findByIsSuccessAndChanelId(RlmsSchedulerConstants.N,RlmsSchedulerConstants.PMVLP_CHNL_ID);

		Map<Long,ELVLPUpdateLoanMainRequestDTO> elVLPUpdateLoanMainRequestDTOMap = new HashMap<>();
		failListData.stream().filter(reqFreqOfFail -> (reqFreqOfFail.getNoRetrys()<3 && null!=reqFreqOfFail.getApplELReverseFeedDataTrn() 
				&& (reqFreqOfFail.getApplELReverseFeedDataTrn().getInitUser().equalsIgnoreCase("APPL") || reqFreqOfFail.getApplELReverseFeedDataTrn().getInitUser().equalsIgnoreCase("SCH"))))
				.forEach(applELRevFeedReqRespTrn -> {
			ApplELReverseFeedDataTrn revFeedDataForVLP = applELRevFeedReqRespTrn.getApplELReverseFeedDataTrn();
			ELVLPUpdateLoanStatusRequestDTO elVlpUpdateLoanStatusRequestDTO = new ELVLPUpdateLoanStatusRequestDTO();
			
			if(StringUtils.isNotEmpty(revFeedDataForVLP.getApplStageId()) && revFeedDataForVLP.getApplStageId().equals("SG5")) {
				
				elVlpUpdateLoanStatusRequestDTO.setStudentAppID(revFeedDataForVLP.getStudentAppId()!=null ? String.valueOf(revFeedDataForVLP.getStudentAppId()):null);
				elVlpUpdateLoanStatusRequestDTO.setBankRefID(revFeedDataForVLP.getSourceApplicationRefNo());
				elVlpUpdateLoanStatusRequestDTO.setAppStatus(revFeedDataForVLP.getAppStatus());
				elVlpUpdateLoanStatusRequestDTO.setRemarks(revFeedDataForVLP.getAppRemarks());
				elVlpUpdateLoanStatusRequestDTO.setBranchIFSC(revFeedDataForVLP.getIfscCode());
				elVlpUpdateLoanStatusRequestDTO.setLoanAccount(revFeedDataForVLP.getAccountNumber());
				elVlpUpdateLoanStatusRequestDTO.setLoanSanctionDt(revFeedDataForVLP.getSanctionedDate() != null
						? DateFormatUtils.format(revFeedDataForVLP.getSanctionedDate(), "dd/MM/yyyy")
						: null);
				elVlpUpdateLoanStatusRequestDTO.setLoanSanctionAmt(revFeedDataForVLP.getSanctionedAmount()!=null ? String.valueOf(revFeedDataForVLP.getSanctionedAmount()):null);
				elVlpUpdateLoanStatusRequestDTO.setROI(revFeedDataForVLP.getRoi()!=null ? String.valueOf(revFeedDataForVLP.getRoi()):null);
				elVlpUpdateLoanStatusRequestDTO.setLoanScheme(revFeedDataForVLP.getLoanScheme()!=null ? String.valueOf(revFeedDataForVLP.getLoanScheme()):null);
				
			}else if(StringUtils.isNotEmpty(revFeedDataForVLP.getApplStageId()) && revFeedDataForVLP.getApplStageId().equals("SG16")) {
				
				elVlpUpdateLoanStatusRequestDTO.setStudentAppID(revFeedDataForVLP.getStudentAppId()!=null ? String.valueOf(revFeedDataForVLP.getStudentAppId()):null);
				elVlpUpdateLoanStatusRequestDTO.setBankRefID(revFeedDataForVLP.getSourceApplicationRefNo());
				elVlpUpdateLoanStatusRequestDTO.setAppStatus(revFeedDataForVLP.getAppStatus());
				elVlpUpdateLoanStatusRequestDTO.setRemarks(revFeedDataForVLP.getAppRemarks());
				elVlpUpdateLoanStatusRequestDTO.setBranchIFSC(revFeedDataForVLP.getIfscCode());
				
			}else if(StringUtils.isNotEmpty(revFeedDataForVLP.getApplStageId()) && revFeedDataForVLP.getApplStageId().equals("SG36")) {
				
			}
			
			ELVLPUpdateLoanBankRequestDtlsAbstract elVlpUpdateLoanBankRequestDtlsAbstract = new ELVLPUpdateLoanBankRequestDtlsAbstract();
			elVlpUpdateLoanBankRequestDtlsAbstract.setBankResponseAbstract(elVlpUpdateLoanStatusRequestDTO);
			elVlpUpdateLoanBankRequestDtlsAbstract.setBankCode("SBIN");
			ELVLPUpdateLoanMainRequestDTO elVlpUpdateLoanMainRequestDTO = new ELVLPUpdateLoanMainRequestDTO();
			elVlpUpdateLoanMainRequestDTO.setBankResponseDtlsAbstract(elVlpUpdateLoanBankRequestDtlsAbstract);
			
			elVLPUpdateLoanMainRequestDTOMap.put(revFeedDataForVLP.getApplRevFeedId(),elVlpUpdateLoanMainRequestDTO);
			log.error("elVlpUpdateLoanMainRequestDTO Json :" + new Gson().toJson(elVlpUpdateLoanMainRequestDTO));
