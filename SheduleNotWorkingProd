package com.sbi.rlms.scheduler.config;

import java.util.Properties;
import javax.sql.DataSource;
import org.quartz.JobDetail;
import org.quartz.Trigger;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.ApplicationContext;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.scheduling.quartz.SchedulerFactoryBean;
import org.springframework.scheduling.quartz.SpringBeanJobFactory;

import com.sbi.rlms.scheduler.listeners.RlmsSchedulerJobListener;

import lombok.Getter;
import lombok.Setter;

@Configuration
@Getter
@Setter
public class RlmsSchedulerConfig {

	@Autowired
	@Qualifier("reverseFeedPMVLPQuartzJobDetail")
	JobDetail reverseFeedPMVLPQuartzJobDetail;
	
	@Autowired
	@Qualifier("reverseFeedPMVLPQuartzJobTrigger")
	Trigger reverseFeedPMVLPQuartzJobTrigger;
	
	@Bean
	public SchedulerFactoryBean rlmsQuatzSchedulerFactoryBean(DataSource quartzDataSource) {
		SchedulerFactoryBean schedulerFactory = new SchedulerFactoryBean();
		schedulerFactory.setJobFactory(springBeanJobFactory());
		schedulerFactory.setTriggers(reverseFeedPMVLPQuartzJobTrigger);
		schedulerFactory.setJobDetails(reverseFeedPMVLPQuartzJobDetail);
		schedulerFactory.setGlobalJobListeners(new RlmsSchedulerJobListener());
		Properties quartzProperties = new Properties();
		quartzProperties.put("org.quartz.threadPool.threadCount", quartzThreadCount);
		schedulerFactory.setQuartzProperties(quartzProperties);
		schedulerFactory.setDataSource(quartzDataSource);
		return schedulerFactory;
	}

	@Bean
	public SpringBeanJobFactory springBeanJobFactory() {
		AutoWiringSpringBeanJobFactory jobFactory = new AutoWiringSpringBeanJobFactory();
		jobFactory.setApplicationContext(applicationContext);
		return jobFactory;
	}

}

