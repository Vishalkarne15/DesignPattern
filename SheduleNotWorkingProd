package com.sbi.rlms.scheduler.tasklet;

import java.util.Map;

import org.springframework.batch.core.StepContribution;
import org.springframework.batch.core.scope.context.ChunkContext;
import org.springframework.batch.core.step.tasklet.Tasklet;
import org.springframework.batch.repeat.RepeatStatus;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;

import com.sbi.rlms.scheduler.constants.RlmsSchedulerConstants;
import com.sbi.rlms.scheduler.dto.ELVLPUpdateLoanMainRequestDTO;
import com.sbi.rlms.scheduler.service.ReversFeedPMVLPService;

import lombok.extern.slf4j.Slf4j;

@Slf4j
public class ReversFeedPMVLPBatchTasklet implements Tasklet {

	@Value("${revers.feed.pmvlp.manual.enable}")
	private String pmvlpTriggerEnable;
	
	@Value("${revers.feed.pmvlp.pool.batch.size}")
	private String batchSizePool;
	
	@Autowired
	private ReversFeedPMVLPService reversFeedPMVLPService;
	
	@Override
	public RepeatStatus execute(StepContribution contribution, ChunkContext context) throws Exception {
		log.info("Start :: Calling PMVLP Service");
		
		log.error("is pmvlpTriggerEnable :: " + pmvlpTriggerEnable);
		if(pmvlpTriggerEnable.equalsIgnoreCase(RlmsSchedulerConstants.Y)) {
			loadPMVLPMannualJSONRequest();
		}
				
		/*
		Map<Long, ELVLPUpdateLoanMainRequestDTO> loadPMVLPJSONRequestMap = reversFeedPMVLPService.loadPMVLPJSONRequest();
		reversFeedPMVLPService.updatePMVLPReqResp(loadPMVLPJSONRequestMap);
		log.info("End :: Calling PMVLP Service");
		*/
		return RepeatStatus.FINISHED;
		
	}
	
	public void loadPMVLPMannualJSONRequest() {
		int batchSize = Integer.parseInt(batchSizePool);
        boolean hasMoreRecords = true;
        while (hasMoreRecords) {
        	hasMoreRecords=reversFeedPMVLPService.prepareAndPushData(batchSize);
        	try {
        		log.error("Watting for 5 second to clean.........");
				Thread.sleep(5000l);
			} catch (InterruptedException e) {
				log.error("Exception in InterruptedException :: "+e.getMessage());
			}
        }
        
	}

}


