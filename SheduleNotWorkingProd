	@Override
	public void updatePMVLPReqResp(Map<Long,ELVLPUpdateLoanMainRequestDTO> elVLPUpdateLoanMainRequestDTOMap) {
		
		elVLPUpdateLoanMainRequestDTOMap.entrySet().stream().forEach(requestData -> {
			
			try {
					ELVLPCheckLoanStatusResponseDTO elVlpEisUpdateLoanStatusResponseDTO = callPMVLPStatusUploadApi(requestData.getValue());
					log.error("elVlpEisUpdateLoanStatusResponseStr Json :"	+ new Gson().toJson(elVlpEisUpdateLoanStatusResponseDTO));
					
					if (null != elVlpEisUpdateLoanStatusResponseDTO
							&& null != elVlpEisUpdateLoanStatusResponseDTO.getResponseStatus()
							&& elVlpEisUpdateLoanStatusResponseDTO.getResponseStatus().equals("0")
							&& null != elVlpEisUpdateLoanStatusResponseDTO.getEisResponse()
							&& null != elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getVlpResponse()
							&& elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getVlpResponse().size() > 0) {
						
						if (StringUtils.isNotEmpty(elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getStatus())
								&& elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getStatus().equals("S")) {
							reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(), RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
								ConversionUtils.convertDtoToJsonString(elVlpEisUpdateLoanStatusResponseDTO), RlmsSchedulerConstants.PMVLP_CHNL_ID);
						} else if (StringUtils.isNotEmpty(elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getStatus())
								&& elVlpEisUpdateLoanStatusResponseDTO.getEisResponse().getStatus().equals("F")) {
							reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(), RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
								ConversionUtils.convertDtoToJsonString(elVlpEisUpdateLoanStatusResponseDTO), RlmsSchedulerConstants.PMVLP_CHNL_ID);
						} else {
							reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(), RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
								null, RlmsSchedulerConstants.PMVLP_CHNL_ID);
						}
					} else if (null != elVlpEisUpdateLoanStatusResponseDTO
							&& null != elVlpEisUpdateLoanStatusResponseDTO.getResponseStatus()
							&& elVlpEisUpdateLoanStatusResponseDTO.getResponseStatus().equals("1")) {
						reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(), RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
								ConversionUtils.convertDtoToJsonString(elVlpEisUpdateLoanStatusResponseDTO), RlmsSchedulerConstants.PMVLP_CHNL_ID);
					} else {
						reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(), RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
								null, RlmsSchedulerConstants.PMVLP_CHNL_ID);
					}
				}catch (HttpClientErrorException e) {
					reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(),RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
							Long.valueOf(e.getStatusCode().value())+"-"+e.getStatusText(), RlmsSchedulerConstants.PMVLP_CHNL_ID);
					log.error("HttpClientErrorException Ocurred : {}", e.getMessage(), e);
				}catch (Exception e) {
					reversFeedPMVLPUpdationService.updateRevFeedStatusOfPMVLP(requestData.getKey(),RlmsSchedulerConstants.Y, ConversionUtils.convertDtoToJsonString(requestData.getValue()), 
							e.getMessage() , RlmsSchedulerConstants.PMVLP_CHNL_ID);
					log.error("HttpClientErrorException Ocurred : {}", e.getMessage(), e);
				}
			
		});
		
	}
	
	@Override
	public ELVLPCheckLoanStatusResponseDTO callPMVLPStatusUploadApi(ELVLPUpdateLoanMainRequestDTO elVLPUpdateLoanMainRequestDTO) {
		ELVLPCheckLoanStatusResponseDTO elVlpEisUpdateLoanStatusResponseDTO = new ELVLPCheckLoanStatusResponseDTO();
		String userToken = AppUtils.generateRlmsToken(schedulerUtils.getExternalUser(), rsaAlgorithm);
		elVlpEisUpdateLoanStatusResponseDTO = ApiUtil.callRestTemplateIntegration(pmvlpIntStatusUploadUrl, elVLPUpdateLoanMainRequestDTO, ELVLPCheckLoanStatusResponseDTO.class, userToken);
		return elVlpEisUpdateLoanStatusResponseDTO;
	}
	
	@Override
	public void updateRevFeedStatusOfPMVLP(Long revFeedId, String successFlag,
			String elVlpUpdateLoanMainRequestDTOStr, 
			String elVlpEisUpdateLoanStatusResponseDTOStr, Long channelId) {
		Optional<ApplELReverseFeedDataTrn> findByApplRevFeedId = applELReverseFeedDataRepository.findByApplRevFeedId(revFeedId);
		ApplELReverseFeedReqRespTrn revFeedReqRespData = applELReverseFeedReqRespRepository.findByApplELReverseFeedDataTrnAndChanelId(findByApplRevFeedId.get(), channelId);
		if(revFeedReqRespData != null) {
			revFeedReqRespData.setJsonReq(elVlpUpdateLoanMainRequestDTOStr);
			revFeedReqRespData.setJsonResp(elVlpEisUpdateLoanStatusResponseDTOStr);
			revFeedReqRespData.setNoRetrys((revFeedReqRespData.getNoRetrys()+1));
			revFeedReqRespData.setLastModDate(new Date());
			revFeedReqRespData.setIsSuccess(successFlag);
			applELReverseFeedReqRespRepository.save(revFeedReqRespData);
		}
	}
	

